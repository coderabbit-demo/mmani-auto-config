{
  "name": "mmani-auto-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests",
    "check": "npm run schema:verify && npm test && npm run build",
    "schema:verify": "node scripts/schema.mjs verify",
    "schema:generate": "node scripts/schema.mjs generate",
    "schema:update": "node scripts/schema.mjs update",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
